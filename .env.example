# Скопируйте в .env.local. Секреты не коммитить.

# Публичные
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Techno Market

# База данных Neon
DATABASE_URL=

# Auth.js
AUTH_SECRET=
# Включите кнопку Google на клиенте + задайте OAuth-ключи:
# NEXT_PUBLIC_GOOGLE_AUTH=1
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Админка (запись каталога в Neon)
ADMIN_PASSWORD=admin123

# YooMoney (без ключей или с YOOMONEY_TEST=1 — симуляция без списания)
YOOMONEY_TEST=1
# YOOMONEY_SHOP_ID=
# YOOMONEY_SECRET_KEY=

# Telegram Mini App (см. web/TELEGRAM.md)
# TELEGRAM_BOT_TOKEN=
